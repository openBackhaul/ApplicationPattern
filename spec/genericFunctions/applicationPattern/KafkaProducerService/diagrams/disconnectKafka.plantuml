@startuml producerDisconnectKafka
skinparam responseMessageBelowArrow true

title
disconnectKafka – Disconnect Kafka Producer
end title

participant "Requestor" as requestor
participant "p1KafkaProducer" as disconnect #LightCyan
participant "Kafka" as kafka #LightYellow

requestor -> disconnect: disconnectKafka()
activate disconnect

disconnect -> kafka
activate kafka
note right of disconnect
connection to 
kafka closed
end note

kafka --> disconnect
deactivate kafka

note over disconnect
  <u>Processing</u>
  - Verify producer instance exists  
  - Stop message publishing  
  - Disconnect from Kafka broker  
  - Release producer resources  
  - Handle disconnect errors safely
end note

disconnect --> requestor
deactivate disconnect

@enduml