@startuml getClientLtpListAsync
skinparam responseMessageBelowArrow true

title
getClientLtpListAsync – Retrieve Client LTP List
end title

participant "requestor" as requestor
participant "LogicalTerminationPoint" as ltp #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json" as cfg #LightGrey

note over requestor
  - ltpUuid
end note

requestor -> ltp: (ltpUuid)
activate ltp

ltp -> jd: read logical-termination-point
activate jd

jd <-> cfg: retrieve control-construct

jd --> ltp: LTP list
deactivate jd

note over ltp
  <u>Processing</u>
  - Read client-ltp list  
  - Extract referenced client LTP UUIDs  
  - Return list of client LTP UUIDs  
  - Return empty array if none exist
end note

ltp --> requestor: Array of clientLtpUuids | []
deactivate ltp

@enduml
