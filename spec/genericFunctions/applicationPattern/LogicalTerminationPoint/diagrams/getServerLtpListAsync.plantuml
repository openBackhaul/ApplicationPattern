@startuml getServerLtpListAsync
skinparam responseMessageBelowArrow true

title
getServerLtpListAsync – Retrieve Server LTP List
end title

participant "requestor" as requestor
participant "LogicalTerminationPoint" as ltp #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json" as cfg #LightGrey

note over requestor
  - ltpUuid
end note

requestor -> ltp: (ltpUuid)
activate ltp

ltp -> jd: read logical-termination-points
activate jd

jd <-> cfg: retrieve control-construct

jd --> ltp: LTP list
deactivate jd

note over ltp
  <u>Processing</u>
  - Locate LTP matching ltpUuid  
  - Read server-ltp list  UUIDs
  - Return array of server LTP UUIDs  
  - Return empty array if none found
end note

ltp --> requestor: Array<serverLtpUuid> | []
deactivate ltp

@enduml
