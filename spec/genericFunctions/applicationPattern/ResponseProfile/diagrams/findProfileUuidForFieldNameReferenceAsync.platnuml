@startuml findProfileUuidForFieldNameReferenceAsync
skinparam responseMessageBelowArrow true

title
findProfileUuidForFieldNameReferenceAsync – Retrieve ResponseProfile UUID by Field Name Reference
end title

participant "requestor" as requestor
participant "ResponseProfile" as rp #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json" as cfg #LightGrey

note over requestor
   fieldNameReference
end note

requestor -> rp: (fieldNameReference)
activate rp

rp -> jd: access profile-collection
activate jd

jd <-> cfg: retrieve control-construct

jd --> rp: Profile-list
deactivate jd

note over rp
  <u>Processing</u>
  - Extract profile list  
  - Identify ResponseProfile entries  
  - Match fieldNameReference  
  - Retrieve UUID of matching ResponseProfile  
  - Prepare response
end note

rp --> requestor: responseProfileUuid | undefined
deactivate rp

@enduml
