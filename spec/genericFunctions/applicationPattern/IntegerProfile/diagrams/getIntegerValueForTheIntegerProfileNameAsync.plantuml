@startuml GetIntegerValueForTheIntegerProfileNameAsync
skinparam responseMessageBelowArrow true

title
GetIntegerValueForTheIntegerProfileNameAsync – Retrieve Integer Value by Profile Name
end title

participant "requestor" as requestor
participant "IntegerProfile" as ip #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json" as cfg #LightGrey

note over requestor
   IntegerProfile name
end note

requestor -> ip: (integerProfileName)
activate ip

ip -> jd: access profile-collection
activate jd

jd <-> cfg: read control-construct

jd --> ip: Profile-list
deactivate jd

note over ip
  <u>Processing</u>
  - Extract profile list  
  - Identify IntegerProfile entries  
  - Match integerProfileName  
  - Read integer-value attribute  
  - Prepare response
end note

ip --> requestor: integerValue (String) | undefined
deactivate ip

@enduml
