@startuml getProfileCollectionAsync
skinparam responseMessageBelowArrow true

title
getProfileCollectionAsync – Retrieve Profile Collection from Control Construct
end title

participant "requestor" as requestor
participant "ControlConstruct" as ccRes #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json" as cfg #LightGrey

note over requestor
 retrieve complete profile-collection object
end note

requestor -> ccRes: (none)
activate ccRes

ccRes -> jd: read profile-collection
activate jd

jd <-> cfg: retrieve control-construct
jd --> ccRes: profile-collection object
deactivate jd

note over ccRes
  <u>Processing</u>
  - No filtering or modification
  - Return full profile-collection object
end note

ccRes --> requestor: profileCollectionObject
deactivate ccRes

@enduml
