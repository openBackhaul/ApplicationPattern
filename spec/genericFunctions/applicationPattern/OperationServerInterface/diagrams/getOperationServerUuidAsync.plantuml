@startuml getOperationServerUuidAsync
skinparam responseMessageBelowArrow true

title
getOperationServerUuidAsync – Retrieve Operation Server UUID by Operation Name
end title

participant "requestor" as requestor
participant "Operation Server " as osRes #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json" as cfg #LightGrey

note over requestor
  - operationName
end note

requestor -> osRes: (operationName)
activate osRes

osRes -> jd: read logical-termination-points
activate jd

jd <-> cfg: retrieve control-construct
jd --> osRes: list of LTPs
deactivate jd

note over osRes
  <u>Processing</u>
  - Iterate through all Logical Termination Points  
  - Filter LTPs with:
      * layer-protocol-name = OPERATION_SERVER  
  - Read operation-server-interface configuration  
  - Match operation-name with input operationName  
  - Return operation server UUID if match found  
  - Return undefined if no match exists
end note

osRes --> requestor: operationServerUuid | undefined
deactivate osRes

@enduml
