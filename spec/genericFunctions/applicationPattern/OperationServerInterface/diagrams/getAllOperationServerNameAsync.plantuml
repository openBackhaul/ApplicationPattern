@startuml GetAllOperationServerNameAsync
skinparam responseMessageBelowArrow true

title
GetAllOperationServerNameAsync – Retrieve All Operation Server Names
end title

participant "requestor" as requestor
participant "Operation Server " as osRes #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json" as cfg #LightGrey

note over requestor
end note

requestor -> osRes: (none)
activate osRes

osRes -> jd: read logical-termination-points
activate jd

jd <-> cfg: retrieve control-construct

jd --> osRes: list of LTPs
deactivate jd

note over osRes
  <u>Processing</u>
  - Iterate through all Logical Termination Points (LTPs)  
  - Filter LTPs with OPERATION_SERVER layer protocol  
  - Access operation-server-interface capability  
  - Extract operation-name attribute  
  - Collect all operation server names  
  - Return list of names  
  - Return empty array if none found
end note

osRes --> requestor: Array<String> (operationServerNames)
deactivate osRes

@enduml
