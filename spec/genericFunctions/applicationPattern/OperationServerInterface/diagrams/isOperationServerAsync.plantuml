@startuml isOperationServerAsync
skinparam responseMessageBelowArrow true

title
isOperationServerAsync – Check Operation Server Layer Protocol
end title

participant "requestor" as requestor
participant "Operation Server " as osr #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json" as cfg #LightGrey

note over requestor
  - operationServerUuid
end note

requestor -> osr: (operationServerUuid)
activate osr

osr -> jd: read logical-termination-points
activate jd

jd <-> cfg: retrieve control-construct

jd --> osr: LTP list
deactivate jd

note over osr
  <u>Processing</u>
  - Locate LTP matching operationServerUuid  
  - Read layer-protocol list  
  - Check layer-protocol-name  
  - Verify OPERATION_SERVER protocol  
  - Return true if matched  
  - Return false otherwise
end note

osr --> requestor: true | false
deactivate osr

@enduml
