@startuml getOperation
skinparam responseMessageBelowArrow true

title
getOperation – Retrieve File Operation Mode
end title

participant "requestor" as requestor
participant "FileProfile" as fp #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json " as cfg #LightGrey

note over requestor
   FileProfile UUID
end note

requestor -> fp: (profileUuid)
activate fp

fp -> jd: read profile-collection
activate jd

jd <-> cfg: retrieve control-construct

jd --> fp: Profile-list
deactivate jd

note over fp
  <u>Processing</u>
  - Extract profile list  
  - Identify FileProfile entries  
  - Match profileUuid  
  - Read operation attribute  
  - Prepare response
end note

fp --> requestor: operationMode | undefined
deactivate fp

@enduml
