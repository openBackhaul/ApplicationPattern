@startuml getActionProfile
skinparam responseMessageBelowArrow true

title
getActionProfile – Retrieve ActionProfile
end title

participant "requestor" as requestor
participant "ActionProfile" as ap #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json" as cfg #LightGrey

note over requestor
   ActionProfile UUID
end note

requestor -> ap: (profileUuid)
activate ap

ap -> jd: access profile-collection
activate jd

jd <-> cfg: retrieve control-construct

jd --> ap: Profile-list
deactivate jd

note over ap
  <u>Processing</u>
  - Extract profile list  
  - Identify ActionProfile entries  
  - Match profileUuid  
  - Prepare ActionProfile object  
  - Return undefined if not found
end note

ap --> requestor: ActionProfile | undefined
deactivate ap

@enduml
