@startuml getStringProfile
skinparam responseMessageBelowArrow true

title
getStringProfile – Retrieve StringProfile
end title

participant "requestor" as requestor
participant "StringProfile" as sp #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json" as cfg #LightGrey

note over requestor
  StringProfile UUID
end note

requestor -> sp: (profileUuid)
activate sp

sp -> jd: access profile-collection
activate jd

jd <-> cfg: retrieve control-construct

jd --> sp: Profile-list
deactivate jd

note over sp
  <u>Processing</u>
  - Extract profile list  
  - Identify StringProfile entries  
  - Match profileUuid  
  - Prepare StringProfile object  
  - Return undefined if not found
end note

sp --> requestor: StringProfile | undefined
deactivate sp

@enduml
