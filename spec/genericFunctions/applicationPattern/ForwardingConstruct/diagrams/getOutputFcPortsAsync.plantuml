@startuml GetOutputFcPortsAsync
skinparam responseMessageBelowArrow true

title
GetOutputFcPortsAsync – Retrieve OUTPUT fc-ports for a Forwarding-Construct
end title

participant "requestor" as requestor
participant "ForwardingConstruct" as fcRes #LightCyan
participant "JSON Driver" as jd #LightYellow
participant "config.json" as cfg #LightGrey

note over requestor
  - forwardingConstructUuid
end note

requestor -> fcRes: (forwardingConstructUuid)
activate fcRes

fcRes -> jd: read forwarding-construct
activate jd

jd <-> cfg: retrieve control-construct
jd --> fcRes: fc-port list from forwarding-construct
deactivate jd

note over fcRes
  <u>Processing</u>
  - Access forwarding-construct by UUID
  - Filter fc-port entries where portDirection = OUTPUT
  - Return array of OUTPUT fc-port objects
  - Return empty array if no OUTPUT ports exist
end note

fcRes --> requestor: List of OUTPUT fc-port objects | []
deactivate fcRes

@enduml
